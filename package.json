{
  "name": "kangs-road-to-championship",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/offline.mjs",
    "test": "node --test tests/*.test.js",
    "refresh-data": "python3 scripts/refresh-data.py",
    "players:lods": "node scripts/player_lods.mjs",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/*.js\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/*.js\" \"scripts/*.mjs\"",
    "check:ui": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "meshoptimizer": "^0.22.0",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
